{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:archway:export-diagnostics:1",
  "type": "object",
  "properties": {
    "command": {
      "const": "export"
    },
    "schema_version": {
      "const": 1
    },
    "tool_versions": {
      "$ref": "#/$defs/versions"
    },
    "resolved_root": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "policy_path": {
      "anyOf": [
        {
          "$ref": "#/$defs/path"
        },
        {
          "type": "null"
        }
      ]
    },
    "policy_hash": {
      "anyOf": [
        {
          "$ref": "#/$defs/hash"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "enum": [
        "ok",
        "invalid_policy",
        "error",
        "usage_error"
      ]
    },
    "exit_code": {
      "enum": [
        0,
        2,
        64
      ]
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      },
      "minItems": 1
    },
    "payload": {
      "type": "object",
      "properties": {
        "format": {
          "enum": [
            "mermaid",
            null
          ]
        },
        "out": {
          "anyOf": [
            {
              "$ref": "#/$defs/path"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "format",
        "out"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "command",
    "schema_version",
    "tool_versions",
    "resolved_root",
    "policy_path",
    "policy_hash",
    "status",
    "exit_code",
    "diagnostics",
    "payload"
  ],
  "additionalProperties": false,
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:\\./|(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*//)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.(?:/|$)).+)$"
    },
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "position": {
      "type": "object",
      "properties": {
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "line",
        "column"
      ],
      "additionalProperties": false
    },
    "range": {
      "type": "object",
      "properties": {
        "path": {
          "$ref": "#/$defs/file_path"
        },
        "start": {
          "$ref": "#/$defs/position"
        },
        "end": {
          "$ref": "#/$defs/position"
        }
      },
      "required": [
        "path",
        "start",
        "end"
      ],
      "additionalProperties": false
    },
    "diagnostic": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "severity": {
          "enum": [
            "error",
            "warning",
            "info"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "rule_pointer": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(?:/(?:[^~/]|~[01])*)*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_range": {
          "anyOf": [
            {
              "$ref": "#/$defs/range"
            },
            {
              "type": "null"
            }
          ]
        },
        "project_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "path": {
          "anyOf": [
            {
              "$ref": "#/$defs/path"
            },
            {
              "type": "null"
            }
          ]
        },
        "recovery_hints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "code",
        "severity",
        "message",
        "rule_pointer",
        "source_range",
        "project_id",
        "path",
        "recovery_hints"
      ],
      "additionalProperties": false
    },
    "versions": {
      "type": "object",
      "properties": {
        "archway": {
          "type": "string",
          "minLength": 1
        },
        "dart_adapter": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "typescript_adapter": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "dart_sdk": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "node": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "typescript": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "archway",
        "dart_adapter",
        "typescript_adapter",
        "dart_sdk",
        "node",
        "typescript"
      ],
      "additionalProperties": false
    },
    "file_path": {
      "allOf": [
        {
          "$ref": "#/$defs/path"
        },
        {
          "pattern": "[^/]$"
        }
      ]
    }
  },
  "oneOf": [
    {
      "properties": {
        "status": {
          "const": "ok"
        },
        "exit_code": {
          "const": 0
        }
      }
    },
    {
      "properties": {
        "status": {
          "const": "invalid_policy"
        },
        "exit_code": {
          "const": 2
        }
      }
    },
    {
      "properties": {
        "status": {
          "const": "error"
        },
        "exit_code": {
          "const": 2
        }
      }
    },
    {
      "properties": {
        "status": {
          "const": "usage_error"
        },
        "exit_code": {
          "const": 64
        }
      }
    }
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "ok"
          }
        }
      },
      "then": {
        "properties": {
          "diagnostics": {
            "items": {
              "properties": {
                "severity": {
                  "enum": [
                    "warning",
                    "info"
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "invalid_policy",
              "error",
              "usage_error"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "diagnostics": {
            "contains": {
              "properties": {
                "severity": {
                  "const": "error"
                }
              }
            }
          }
        }
      }
    }
  ]
}
