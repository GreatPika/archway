{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Archway private TypeScript helper request v2",
  "type": "object",
  "properties": {
    "protocol_version": {
      "const": 2
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "root_uri": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^file:///(?:[^\\s?#]|%[0-9A-Fa-f]{2})+$"
        },
        {
          "const": "file:///"
        }
      ]
    },
    "config_path": {
      "type": "string",
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//).+$"
    },
    "expected_files": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//).+$"
      },
      "uniqueItems": true,
      "minItems": 0
    }
  },
  "required": [
    "protocol_version",
    "request_id",
    "project_id",
    "root_uri",
    "config_path",
    "expected_files"
  ],
  "additionalProperties": false,
  "$defs": {}
}
