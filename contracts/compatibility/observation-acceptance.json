{
  "purpose": "Future implementation acceptance cases for cross-project aggregation and independent input revalidation; no actual compiler execution is represented. Hash labels A/B abbreviate differing valid SHA-256 values in fixture setup.",
  "cases": [
    {
      "id": "IC01",
      "scenario": "Two project manifests disagree on shared package manifest hash; final read matches first",
      "projects": [
        "a",
        "b",
        "c"
      ],
      "dependent_projects": [
        "a",
        "b"
      ],
      "observations": [
        {
          "project": "a",
          "hash": "A"
        },
        {
          "project": "b",
          "hash": "B"
        }
      ],
      "final_hash": "A",
      "expected": {
        "status": "incomplete",
        "exit_code": 2,
        "diagnostic": "INPUT_CHANGED",
        "invalidated_fact_projects": [
          "a",
          "b"
        ],
        "retained_fact_projects": [
          "c"
        ],
        "unresolved_project_ids": [
          "a",
          "b"
        ],
        "discovery_complete": false,
        "assignment": "failed",
        "preserve_independent_violations": true
      }
    },
    {
      "id": "IC02",
      "scenario": "Parent baseline absence disagrees with project presence; final read matches project",
      "dependent_projects": [
        "a"
      ],
      "parent_presence": "absent",
      "project_presence": "present",
      "final_presence": "present",
      "expected": {
        "status": "incomplete",
        "diagnostic": "INPUT_CHANGED",
        "baseline_presence": "absent",
        "invalidated_fact_projects": [
          "a"
        ],
        "discovery_complete": false
      }
    },
    {
      "id": "IC03",
      "scenario": "Same observed alias maps to two targets, including baseline supplier",
      "dependent_projects": [
        "a",
        "b"
      ],
      "observed_uri": "file:///repo/package_alias/pkg",
      "canonical_targets": [
        "file:///repo/packages/pkg",
        "file:///cache/pkg"
      ],
      "expected": {
        "status": "incomplete",
        "diagnostic": "INPUT_CHANGED",
        "invalidated_fact_projects": [
          "a",
          "b"
        ],
        "discovery_complete": false,
        "assignment": "failed"
      }
    },
    {
      "id": "IC04",
      "scenario": "Reverse project completion order with identical observations",
      "completion_orders": [
        [
          "a",
          "b"
        ],
        [
          "b",
          "a"
        ]
      ],
      "expected": {
        "same_serialized_result": true,
        "baseline_order": "parent then sorted project_id",
        "no_change_diagnostic": true
      }
    },
    {
