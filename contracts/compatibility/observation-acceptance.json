      "scenario": "Source analyzed before a inherited shared-input conflict",
      "expected": {
        "file_analysis": "partial",
        "project_status": "partial",
        "assignment": "failed",
        "preserve_historical_candidates": true,
        "preserve_descriptors": true
      }
    },
    {
      "id": "IC06",
      "scenario": "Same canonical file appears as source in one project and resolution in another with different bytes",
      "observations": [
        {
          "project": "a",
          "role": "source",
          "canonical_uri": "file:///repo/shared.dart",
          "hash": "A"
        },
        {
          "project": "b",
          "role": "resolution",
          "canonical_uri": "file:///repo/shared.dart",
          "hash": "B"
        }
      ],
      "expected": {
        "status": "incomplete",
        "diagnostic": "INPUT_CHANGED",
        "invalidated_fact_projects": [
          "a",
          "b"
        ],
        "discovery_complete": false,
        "representation_unique_by": "kind+location",
        "conflict_detection": "underlying location regardless of role"
